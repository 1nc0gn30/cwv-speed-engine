[Desktop Entry]
Version=1.0
Type=Application
Name=CWV Speed Studio
GenericName=Core Web Vitals & Performance Workstation
Comment=Zero-Dependency Core Web Vitals Speed Engine, Speculation Rules, PWA & LoAF Profiler
Exec=/usr/local/bin/cwv desktop
Icon=cwv-speed-engine
Terminal=false
Categories=Development;WebDevelopment;Utility;
StartupNotify=true
Actions=CLI;Web;

[Desktop Action CLI]
Name=Open CWV Speed CLI
Exec=x-terminal-emulator -e "/usr/local/bin/cwv --help"

[Desktop Action Web]
Name=Open Web UI (Port 8128)
Exec=/usr/local/bin/cwv web
